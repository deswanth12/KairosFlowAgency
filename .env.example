# ==============================================================================
# KAIROS FLOW AGENCY — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Authentication Secrets (REQUIRED IN PRODUCTION — min 32 chars random secret)
ADMIN_JWT_SECRET=

# Team User Password Hashes (REQUIRED FOR LOGIN — bcrypt cost 12 hashes)
# Format: JSON string mapping user ID to bcrypt hash
# Example: TEAM_PASSWORD_HASHES={"usr-desvanth":"$2b$12$...","usr-basha":"$2b$12$..."}
# Generate hash: node -e "require('bcryptjs').hash('YourSecurePassword',12).then(console.log)"
TEAM_PASSWORD_HASHES=

# Cloud Distributed Persistence (REQUIRED for Vercel / Multi-instance serverless)
# Upstash Redis REST API credentials
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Meta WhatsApp Business Cloud API Integration (Optional / Production)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
